# Public site origin — used for canonical URLs, sitemap, robots, and OG tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://shyenasec.com

# Optional Google Analytics measurement ID. Analytics is omitted when blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Formspree form ID. The contact page shows an email fallback while blank.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# Optional social profile URLs. Footer icons and Organization sameAs entries
# render only for URLs that are set. Leave blank until ready.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
